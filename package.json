{
  "name": "cttagents-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CTT Agent Portal: a travel-advisor CRM front end over GoHighLevel, on Cloudflare Workers + D1.",
  "scripts": {
    "check:all": "npm run check:migrations && npm run check:wiring && npm run check:payments && npm run check:writes && npm run check:forms && npm run check:dom && npm run check:fork && npm run check:dashes && npm run check:escapes && npm run check:sending && npm run check:private && npm run check:email && npm run check:routes && npm run check:columns && npm run check:shapes && npm run check:keep && npm run check:reads && npm run check:contracts && npm run check:smoke",
    "check:columns": "node scripts/check-columns.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check:reads": "node scripts/check-reads.mjs",
    "check:dom": "node scripts/check-dom.mjs",
    "check:conditional": "node scripts/check-conditional.mjs",
    "check:members": "node scripts/check-members.mjs",
    "check:fork": "node scripts/check-fork.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:scope": "node scripts/check-scope.mjs",
    "check:keep": "node scripts/check-keep.mjs",
    "check:shapes": "node scripts/check-shapes.mjs",
    "check:smoke": "node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply cttagents --remote",
    "db:migrate:local": "wrangler d1 migrations apply cttagents --local",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "precheck:columns": "node scripts/check-scope.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "check:wiring": "node scripts/check-wiring.mjs",
    "check:writes": "node scripts/check-writes.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:email": "node scripts/check-email.mjs",
    "check:escapes": "node scripts/check-escapes.mjs",
    "check:sending": "node scripts/check-sending.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
